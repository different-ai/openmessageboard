{
  "name": "@openmessageboard/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "The OpenMessageBoard specification website: the spec rendered from spec/v0.1, built with Astro and served from Cloudflare.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler d1 migrations apply NEWSLETTER --remote && wrangler deploy",
    "typecheck": "astro check",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@fontsource-variable/source-serif-4": "^5.2.0",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "wrangler": "^4.168.0"
  }
}
