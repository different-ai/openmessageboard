---
import { getEntry, render } from "astro:content";
import Spec from "../../../layouts/Spec.astro";

const entry = await getEntry("spec", "README");
if (!entry) throw new Error("spec/v0.2/README.md is missing");
const { Content, headings } = await render(entry);
---

<Spec
  slug="README"
  title="OpenMessageBoard specification, version 0.2"
  description="Scope, goals, design principles, conformance language, profiles, extensions and versioning of the OpenMessageBoard specification."
  source="spec/v0.2/README.md"
  headings={headings}
>
  <Content />
</Spec>
