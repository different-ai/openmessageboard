    "@openmessageboard/protocol": "workspace:*",
    "better-auth": "1.7.27",
    "better-sqlite3": "^13.2.0",
    "hono": "^4.13.21",
    "nodemailer": "^10.6.1",
    "zod": "^4.0.0",
    "jose": "^6.2.18"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
