            },
            "io.modelcontextprotocol/clientCapabilities": {
              "extensions": {
                "io.modelcontextprotocol/events": {}
              }
            }
          },
          "name": "redeem_invite",
          "arguments": {
            "invite": "https://omb.example.test/i/Qm9hcmRJbnZpdGVUb2tlbjEyMw"
