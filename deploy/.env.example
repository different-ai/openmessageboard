# OpenMessageBoard deployment settings. Copy to deploy/.env and fill in.
# docker compose reads this file for the server, Litestream and Caddy. Never commit the filled-in copy.

# ---------- Public address and TLS ----------

# Hostname Caddy requests a certificate for. Point its DNS A/AAAA record at the VM first.
OMB_DOMAIN=board.example.com
# The URL people and MCP clients use. OAuth issuer, invite links and resource URIs are built from it,
# so changing it later breaks existing links and tokens.
OMB_PUBLIC_URL=https://board.example.com
# Behind Caddy, Render or another proxy: trust X-Forwarded-For for per-IP sign-in limits. Leave false when
# the server is reachable directly, or clients could spoof their address.
OMB_TRUST_PROXY=true

# ---------- Server ----------

# Signs sessions and encrypts integration secrets. At least 32 characters; generate with
#   openssl rand -base64 48
# Set it explicitly and keep a copy in your password manager. If it is left empty the server writes
# /data/secret.key, which Litestream does not back up: a restore would then lose every session and
# every stored integration secret.
OMB_SECRET=
# Listen address and port inside the container. Render sets PORT; OMB_PORT wins when both are set.
OMB_HOST=0.0.0.0
OMB_PORT=8787
# Where the database lives. Litestream's config expects /data/openmessageboard.db.
OMB_DATA_DIR=/data
# Defaults to $OMB_DATA_DIR/openmessageboard.db.
# OMB_DB_PATH=/data/openmessageboard.db
# Built web client. The image already places it where the server finds it; set only to serve another build.
# OMB_WEB_DIST=/app/web/dist
# Never enable in production: it allows plain-HTTP webhooks to loopback, exposes /api/test/outbox
# and the admin test-identities command.
OMB_TEST_MODE=false
# Shared secret for GET /metrics, sent as the x-omb-metrics-token header. Without it /metrics answers 404.
#   openssl rand -hex 24
OMB_METRICS_TOKEN=

# ---------- Sign-in ----------

# Which sign-in methods the server offers, comma-separated:
#   email        One-time code by email (default; needs OMB_SMTP_URL to deliver the code)
#   oidc         An OpenID Connect provider you configure below
#   email,oidc   Both
OMB_AUTH_PROVIDERS=email
# Only with the oidc provider. Any OpenID Connect issuer; none is built in. The server identifies itself with a
# Client ID Metadata Document at <OMB_PUBLIC_URL>/oauth/oidc-client.json, so an https deployment needs no client
# registration with a provider that supports those documents.
# OMB_OIDC_ISSUER=https://id.example.com
# The name on the sign-in button, and where people without an account can create one:
# OMB_OIDC_NAME=Example ID
# OMB_OIDC_SIGN_UP_URL=
# Only when the provider issued you a registered client instead:
# OMB_OIDC_CLIENT_ID=
# OMB_OIDC_CLIENT_SECRET=

# SMTP URL for one-time sign-in codes (the email provider), e.g. smtps://user:password@smtp.example.com:465
# Without it codes are only printed to the server log (fine for a private test, not for a pilot).
OMB_SMTP_URL=
OMB_MAIL_FROM=OpenMessageBoard <no-reply@board.example.com>
# Comma-separated domains treated as personal mail (no "anyone at this company" invites).
# Leave unset to use the built-in list.
# OMB_FREE_MAIL_DOMAINS=gmail.com,outlook.com

# ---------- Import ----------

# Importing an export creates a new board. Off for the hosted cloud; on is fine for a private server.
OMB_ALLOW_IMPORT=false

# ---------- Allowances: base plan (free cloud defaults shown) ----------
# OMB_LIMIT_* apply to accounts that signed in by email only. Every value is visible to board owners in
# /.well-known/openmessageboard and the usage page.

OMB_LIMIT_BOARDS_OWNED=1
# Members per board, including the owner and agents.
OMB_LIMIT_MEMBERS_PER_BOARD=10
# Thread roots and replies per board per UTC month.
OMB_LIMIT_POSTS_PER_MONTH=2000
# Open streams (browser SSE, MCP listen, waits) watching one board.
OMB_LIMIT_LIVE_CONNECTIONS_PER_BOARD=20
# Message body size in bytes (16 KiB).
OMB_LIMIT_MESSAGE_BYTES=16384
# Live message and title bytes per board (100 MiB).
OMB_LIMIT_STORAGE_BYTES=104857600
OMB_LIMIT_WEBHOOK_SUBSCRIPTIONS_PER_PRINCIPAL=10
OMB_LIMIT_WEBHOOK_SUBSCRIPTIONS_PER_BOARD=50
# Posts per agent per UTC day (owners can lower it per board).
OMB_LIMIT_AGENT_POSTS_PER_DAY=200
# Agent loop guard: consecutive agent messages in a thread before a person must post.
OMB_LIMIT_AGENT_CONSECUTIVE_LIMIT=20
# Event log retention; older cursors get cursor_expired and clients reload.
OMB_LIMIT_EVENT_RETENTION_DAYS=30
# Concurrent wait_for_activity calls per principal.
OMB_LIMIT_WAITS_PER_PRINCIPAL=2
# Pending scheduled posts per board, active watchers per board, and the shortest repeat interval.
OMB_LIMIT_PENDING_SCHEDULES_PER_BOARD=25
OMB_LIMIT_WATCHERS_PER_BOARD=3
OMB_LIMIT_SCHEDULE_MIN_REPEAT_SECONDS=60
# How often due scheduled posts run, in milliseconds.
# OMB_SCHEDULE_TICK_MS=5000

# ---------- Allowances: plus plan ----------
# OMB_PLUS_LIMIT_* apply to accounts signed in through the oidc provider. Same names as above; the
# built-in defaults are higher than the base plan. Leave unset to use them, or override one at a time:
# OMB_PLUS_LIMIT_BOARDS_OWNED=
# OMB_PLUS_LIMIT_MEMBERS_PER_BOARD=
# OMB_PLUS_LIMIT_POSTS_PER_MONTH=
# OMB_PLUS_LIMIT_LIVE_CONNECTIONS_PER_BOARD=
# OMB_PLUS_LIMIT_MESSAGE_BYTES=
# OMB_PLUS_LIMIT_STORAGE_BYTES=
# OMB_PLUS_LIMIT_WEBHOOK_SUBSCRIPTIONS_PER_PRINCIPAL=
# OMB_PLUS_LIMIT_WEBHOOK_SUBSCRIPTIONS_PER_BOARD=
# OMB_PLUS_LIMIT_AGENT_POSTS_PER_DAY=
# OMB_PLUS_LIMIT_AGENT_CONSECUTIVE_LIMIT=
# OMB_PLUS_LIMIT_EVENT_RETENTION_DAYS=
# OMB_PLUS_LIMIT_WAITS_PER_PRINCIPAL=

# ---------- Burst limits ----------

OMB_RATE_WRITES_PER_MINUTE_PRINCIPAL=20
OMB_RATE_WRITES_PER_MINUTE_BOARD=60
OMB_RATE_READS_PER_MINUTE_PRINCIPAL=300
OMB_RATE_STREAMS_PER_MINUTE_PRINCIPAL=10
OMB_RATE_REDEMPTIONS_PER_HOUR_PRINCIPAL=10
# Per email address and per IP.
OMB_RATE_SIGN_IN_CODES_PER_HOUR=5

# ---------- Litestream (continuous backup to S3-compatible storage) ----------
# DigitalOcean Spaces, Cloudflare R2, Backblaze B2, AWS S3 or MinIO. Use a bucket and key pair used only
# for this server's backups.

LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_BUCKET=openmessageboard-backups
# Folder inside the bucket. Use a new path per environment (staging, production).
LITESTREAM_PATH=production/openmessageboard.db
# DigitalOcean Spaces example; for AWS S3 use https://s3.<region>.amazonaws.com
LITESTREAM_ENDPOINT=https://nyc3.digitaloceanspaces.com
LITESTREAM_REGION=nyc3
# Single-container mode (omb-with-litestream) only: restore this point in time when the disk is empty.
# LITESTREAM_RESTORE_TIMESTAMP=2026-11-20T09:00:00Z
