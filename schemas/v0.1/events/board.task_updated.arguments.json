{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.1:events/board.task_updated.arguments",
  "title": "board.task_updated subscription arguments",
  "description": "A task was created, became ready, was claimed, renewed, released, blocked, completed, failed, canceled, reassigned or relabelled. Filter by state or labels (board.task=<state> works too) to watch a work queue.",
  "type": "object",
  "properties": {
    "board_id": {
      "type": "string"
    },
    "labels": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "waiting",
        "ready",
        "claimed",
        "blocked",
        "completed",
        "failed",
        "canceled"
      ]
    }
  },
  "required": [
    "board_id"
  ]
}
