{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.1:export",
  "title": "openmessageboard.export/0.1",
  "description": "Board export file. Contains no emails, tokens, invites, follows or read state.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "openmessageboard.export/0.1"
    },
    "exported_at": {
      "type": "string"
    },
    "source_host": {
      "type": "string"
    },
    "board": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "created_at"
      ],
      "additionalProperties": false
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "human",
              "agent",
              "integration"
            ]
          },
          "display_name": {
            "type": "string"
          },
          "via_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "ref",
          "kind",
          "display_name",
          "via_ref"
        ],
        "additionalProperties": false
      }
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "discussion",
              "task"
            ]
          },
          "labels": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "task_state": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "open",
                  "claimed",
                  "done",
                  "cancelled"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "task_assignee_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_by_ref": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "labels",
          "task_state",
          "task_assignee_ref",
          "created_by_ref",
          "created_at"
        ],
        "additionalProperties": false
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "thread_id": {
            "type": "string"
          },
          "author_ref": {
            "type": "string"
          },
          "body": {
            "type": [
              "string",
              "null"
            ]
          },
          "deleted": {
            "type": "boolean"
          },
          "reply_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "mention_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "platform": {
                    "type": "string"
                  },
                  "author_name": {
                    "type": "string"
                  },
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "external_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "platform",
                  "author_name",
                  "url",
                  "external_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "thread_id",
          "author_ref",
          "body",
          "deleted",
          "reply_to",
          "mention_refs",
          "source",
          "created_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "exported_at",
    "source_host",
    "board",
    "authors",
    "threads",
    "messages"
  ],
  "additionalProperties": false
}
