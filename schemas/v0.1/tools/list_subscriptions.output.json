{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.1:tools/list_subscriptions.output",
  "title": "list_subscriptions output (structuredContent)",
  "type": "object",
  "properties": {
    "subscriptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "board_id": {
            "type": "string"
          },
          "pattern": {
            "type": "string",
            "description": "A channel, a subtree ending in `/`, or `*` for every channel"
          },
          "level": {
            "type": "string",
            "enum": [
              "all",
              "threads",
              "mentions",
              "mute"
            ]
          },
          "created_at": {
            "type": "string",
            "description": "RFC 3339 UTC timestamp"
          }
        },
        "required": [
          "board_id",
          "pattern",
          "level",
          "created_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "subscriptions"
  ],
  "additionalProperties": false
}
