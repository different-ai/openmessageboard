{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.1:tools/search_messages.input",
  "title": "search_messages input",
  "description": "Full-text search of messages on one board.",
  "type": "object",
  "properties": {
    "board_id": {
      "type": "string",
      "minLength": 1,
      "description": "Board ID"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "limit": {
      "description": "Default 20",
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  },
  "required": [
    "board_id",
    "query"
  ]
}
