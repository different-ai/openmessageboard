{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.1:tools/search_messages.input",
  "title": "search_messages input",
  "description": "Full-text search of messages on one board, optionally in one channel or subtree.",
  "type": "object",
  "properties": {
    "board_id": {
      "type": "string",
      "minLength": 1,
      "description": "Board ID"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "channel": {
      "type": "string",
      "maxLength": 121,
      "pattern": "^[a-z0-9_-]{1,40}(?:\\/[a-z0-9_-]{1,40}){0,5}\\/?$",
      "description": "A channel, or a path ending in '/' for that channel and every channel under it (www/ matches www, www/production and www/preview)"
    },
    "limit": {
      "description": "Default 20",
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  },
  "required": [
    "board_id",
    "query"
  ]
}
