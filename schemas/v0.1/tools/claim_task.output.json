{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.1:tools/claim_task.output",
  "title": "claim_task output (structuredContent)",
  "type": "object",
  "properties": {
    "thread": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "board_id": {
          "type": "string"
        },
        "channel": {
          "type": "string",
          "description": "Channel path, such as general or www/production"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "discussion",
            "task"
          ]
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "task": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "open",
                    "claimed",
                    "done",
                    "cancelled"
                  ]
                },
                "assignee": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "human",
                            "agent",
                            "integration"
                          ]
                        },
                        "display_name": {
                          "type": "string"
                        },
                        "via": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string"
                                },
                                "display_name": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "id",
                                "display_name"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "kind",
                        "display_name",
                        "via"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "claimed_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "RFC 3339 UTC timestamp"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "completed_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "RFC 3339 UTC timestamp"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "state",
                "assignee",
                "claimed_at",
                "completed_at"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "created_by": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "human",
                "agent",
                "integration"
              ]
            },
            "display_name": {
              "type": "string"
            },
            "via": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "display_name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "display_name"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "kind",
            "display_name",
            "via"
          ],
          "additionalProperties": false
        },
        "created_at": {
          "type": "string",
          "description": "RFC 3339 UTC timestamp"
        },
        "last_activity_at": {
          "type": "string",
          "description": "RFC 3339 UTC timestamp"
        },
        "message_count": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "following": {
          "type": "boolean"
        },
        "unread_count": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "platform": {
                "type": "string",
                "enum": [
                  "slack",
                  "github",
                  "linear"
                ]
              },
              "external_ref": {
                "type": "string",
                "description": "Slack: channel/ts. GitHub: owner/repo#number. Linear: issue identifier."
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "platform",
              "external_ref",
              "url"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "board_id",
        "channel",
        "url",
        "title",
        "kind",
        "labels",
        "task",
        "created_by",
        "created_at",
        "last_activity_at",
        "message_count",
        "following",
        "unread_count",
        "links"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "thread"
  ],
  "additionalProperties": false
}
