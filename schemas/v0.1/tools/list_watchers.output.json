{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.1:tools/list_watchers.output",
  "title": "list_watchers output (structuredContent)",
  "type": "object",
  "properties": {
    "watchers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "board_id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "filter": {
            "type": "object",
            "properties": {
              "thread": {
                "description": "One thread: a thread ID, or any message ID in it",
                "type": "string",
                "minLength": 1
              },
              "types": {
                "description": "Change types; default every type",
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "thread.created",
                    "thread.updated",
                    "message.created",
                    "message.deleted",
                    "message.edited",
                    "reactions.changed",
                    "labels.changed",
                    "member.joined",
                    "member.updated",
                    "member.left",
                    "board.updated"
                  ]
                }
              },
              "channel": {
                "description": "A channel, or a path ending in '/' for the channel and its subtree",
                "type": "string",
                "maxLength": 121,
                "pattern": "^[a-z0-9_-]{1,40}(?:\\/[a-z0-9_-]{1,40}){0,5}\\/?$"
              },
              "by": {
                "description": "Author: 'me', a handle (a profile's is person/profile) or a principal ID. A person covers their profiles and the agents that act for them",
                "type": "string",
                "minLength": 1
              },
              "mentions": {
                "description": "Mentioning this principal: 'me', a handle or a principal ID",
                "type": "string",
                "minLength": 1
              },
              "labels": {
                "description": "Every key must match, on the message or on its thread's root. A value of 'a|b' matches either; board.task matches the task state",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "text": {
                "description": "Case-insensitive substring of the body",
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "source": {
                "description": "Where the message came from: 'board' or a sync platform",
                "type": "string",
                "enum": [
                  "board",
                  "slack",
                  "github",
                  "linear"
                ]
              }
            },
            "additionalProperties": false,
            "description": "Handles are stored as principal IDs"
          },
          "created_by": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "human",
                  "agent",
                  "integration"
                ]
              },
              "display_name": {
                "type": "string"
              },
              "via": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "display_name": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "display_name"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "display_name",
              "via"
            ],
            "additionalProperties": false
          },
          "created_at": {
            "type": "string",
            "description": "RFC 3339 UTC timestamp"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "stopped"
            ]
          },
          "stopped_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "recent_deliveries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "change_seq": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "change_type": {
                  "type": "string",
                  "enum": [
                    "thread.created",
                    "thread.updated",
                    "message.created",
                    "message.deleted",
                    "message.edited",
                    "reactions.changed",
                    "labels.changed",
                    "member.joined",
                    "member.updated",
                    "member.left",
                    "board.updated"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "delivered",
                    "failed"
                  ]
                },
                "attempts": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "last_error": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "created_at": {
                  "type": "string",
                  "description": "RFC 3339 UTC timestamp"
                },
                "delivered_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "RFC 3339 UTC timestamp"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "change_seq",
                "change_type",
                "status",
                "attempts",
                "last_error",
                "created_at",
                "delivered_at"
              ],
              "additionalProperties": false
            },
            "description": "The most recent deliveries, newest first"
          }
        },
        "required": [
          "id",
          "board_id",
          "url",
          "filter",
          "created_by",
          "created_at",
          "status",
          "stopped_reason",
          "recent_deliveries"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "watchers"
  ],
  "additionalProperties": false
}
