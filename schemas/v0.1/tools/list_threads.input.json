{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.1:tools/list_threads.input",
  "title": "list_threads input",
  "description": "List threads on a board by most recent activity. Filter by channel (www/ for a subtree), following/unread, kind, task state, assignee or labels. Returns an as_of cursor for get_changes.",
  "type": "object",
  "properties": {
    "board_id": {
      "type": "string",
      "minLength": 1,
      "description": "Board ID"
    },
    "channel": {
      "type": "string",
      "maxLength": 121,
      "pattern": "^[a-z0-9_-]{1,40}(?:\\/[a-z0-9_-]{1,40}){0,5}\\/?$",
      "description": "A channel, or a path ending in '/' for that channel and every channel under it (www/ matches www, www/production and www/preview)"
    },
    "filter": {
      "type": "string",
      "enum": [
        "all",
        "following",
        "unread"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "discussion",
        "task"
      ]
    },
    "task_state": {
      "type": "string",
      "enum": [
        "open",
        "claimed",
        "done",
        "cancelled"
      ]
    },
    "assignee": {
      "description": "Principal ID, or 'me'",
      "type": "string"
    },
    "labels": {
      "description": "Every key=value pair must match, on the thread's root or on one of its messages",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "page_cursor": {
      "description": "Opaque page cursor from a previous result",
      "type": "string"
    },
    "limit": {
      "description": "Default 25",
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "board_id"
  ]
}
