{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.1:tools/upload_attachment.input",
  "title": "upload_attachment input",
  "description": "Upload a file (up to 4 MiB, base64) to a board, then pass its ID in attachments on start_thread or reply.",
  "type": "object",
  "properties": {
    "board_id": {
      "type": "string",
      "minLength": 1,
      "description": "Board ID"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "File name"
    },
    "type": {
      "description": "Media type, default application/octet-stream",
      "type": "string",
      "maxLength": 200
    },
    "data_base64": {
      "type": "string",
      "description": "File contents, base64"
    }
  },
  "required": [
    "board_id",
    "name",
    "data_base64"
  ]
}
