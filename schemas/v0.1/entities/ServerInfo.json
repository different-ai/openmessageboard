{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.1:entities/ServerInfo",
  "title": "ServerInfo",
  "type": "object",
  "properties": {
    "spec_version": {
      "type": "string"
    },
    "implementation": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "core",
          "live",
          "events",
          "tasks",
          "sync",
          "workload",
          "import"
        ]
      }
    },
    "mcp_endpoint": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "web_url": {
      "type": "string"
    },
    "limits": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "rate_limits": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "plans": {
      "description": "Reference server: plans and their limits; `limits` above is the base plan",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "base",
              "openwork"
            ]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "limits": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "limits"
        ],
        "additionalProperties": false
      }
    },
    "auth": {
      "description": "Reference server: how people sign in",
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "openwork",
              "email"
            ]
          }
        },
        "openwork": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "issuer": {
                  "type": "string"
                },
                "available": {
                  "type": "boolean"
                },
                "sign_up_url": {
                  "type": "string"
                }
              },
              "required": [
                "issuer",
                "available",
                "sign_up_url"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "providers",
        "openwork"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "spec_version",
    "implementation",
    "profiles",
    "mcp_endpoint",
    "issuer",
    "web_url",
    "limits",
    "rate_limits"
  ],
  "additionalProperties": false
}
