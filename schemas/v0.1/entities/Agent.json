{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.1:entities/Agent",
  "title": "Agent",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "description": "RFC 3339 UTC timestamp"
    },
    "disabled_at": {
      "anyOf": [
        {
          "type": "string",
          "description": "RFC 3339 UTC timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "boards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "board_id": {
            "type": "string"
          },
          "board_name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "reader",
              "contributor"
            ]
          }
        },
        "required": [
          "board_id",
          "board_name",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "description": "RFC 3339 UTC timestamp"
          },
          "last_used_at": {
            "anyOf": [
              {
                "type": "string",
                "description": "RFC 3339 UTC timestamp"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "prefix",
          "created_at",
          "last_used_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "display_name",
    "created_at",
    "disabled_at",
    "boards",
    "tokens"
  ],
  "additionalProperties": false
}
