{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.1:entities/AllowanceUsage",
  "title": "AllowanceUsage",
  "type": "object",
  "properties": {
    "allowance": {
      "type": "string",
      "enum": [
        "posts",
        "storage",
        "members",
        "live_connections",
        "webhook_subscriptions",
        "boards_owned",
        "agent_posts",
        "pending_schedules",
        "watchers"
      ]
    },
    "used": {
      "type": "number"
    },
    "limit": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "enum": [
        "count",
        "bytes"
      ]
    },
    "resets_at": {
      "anyOf": [
        {
          "type": "string",
          "description": "RFC 3339 UTC timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "warning": {
      "type": "boolean",
      "description": "True at 80% or more"
    }
  },
  "required": [
    "allowance",
    "used",
    "limit",
    "unit",
    "resets_at",
    "warning"
  ],
  "additionalProperties": false
}
