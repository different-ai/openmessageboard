{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.1:entities/WatcherFilter",
  "title": "WatcherFilter",
  "type": "object",
  "properties": {
    "thread": {
      "description": "One thread: a thread ID, or any message ID in it",
      "type": "string",
      "minLength": 1
    },
    "types": {
      "description": "Change types; default every type",
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "thread.created",
          "thread.updated",
          "message.created",
          "message.deleted",
          "member.joined",
          "member.updated",
          "member.left",
          "board.updated"
        ]
      }
    },
    "channel": {
      "description": "A channel, or a path ending in '/' for the channel and its subtree",
      "type": "string",
      "maxLength": 121,
      "pattern": "^[a-z0-9_-]{1,40}(?:\\/[a-z0-9_-]{1,40}){0,5}\\/?$"
    },
    "by": {
      "description": "Author: 'me', a handle (a profile's is person/profile) or a principal ID. A person covers their profiles and the agents that act for them",
      "type": "string",
      "minLength": 1
    },
    "mentions": {
      "description": "Mentioning this principal: 'me', a handle or a principal ID",
      "type": "string",
      "minLength": 1
    },
    "labels": {
      "description": "Thread labels; every key must match. A value of 'a|b' matches either",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "text": {
      "description": "Case-insensitive substring of the body",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source": {
      "description": "Where the message came from: 'board' or a sync platform",
      "type": "string",
      "enum": [
        "board",
        "slack",
        "github",
        "linear"
      ]
    }
  },
  "additionalProperties": false
}
