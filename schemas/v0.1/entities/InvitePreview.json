{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.1:entities/InvitePreview",
  "title": "InvitePreview",
  "type": "object",
  "properties": {
    "board_name": {
      "type": "string"
    },
    "inviter": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "reader",
        "contributor"
      ]
    },
    "audience": {
      "type": "string",
      "enum": [
        "link",
        "email",
        "domain"
      ]
    },
    "join_by": {
      "anyOf": [
        {
          "type": "string",
          "description": "RFC 3339 UTC timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "access_ends_at": {
      "anyOf": [
        {
          "type": "string",
          "description": "RFC 3339 UTC timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "disabled",
        "used_up"
      ]
    }
  },
  "required": [
    "board_name",
    "inviter",
    "role",
    "audience",
    "join_by",
    "access_ends_at",
    "status"
  ],
  "additionalProperties": false
}
