{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.1:entities/TaskInfo",
  "title": "TaskInfo",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "open",
        "claimed",
        "done",
        "cancelled"
      ]
    },
    "assignee": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "human",
                "agent",
                "integration"
              ]
            },
            "display_name": {
              "type": "string"
            },
            "via": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "display_name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "display_name"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "kind",
            "display_name",
            "via"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "claimed_at": {
      "anyOf": [
        {
          "type": "string",
          "description": "RFC 3339 UTC timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "string",
          "description": "RFC 3339 UTC timestamp"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "state",
    "assignee",
    "claimed_at",
    "completed_at"
  ],
  "additionalProperties": false
}
