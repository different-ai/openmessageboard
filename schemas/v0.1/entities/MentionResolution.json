{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.1:entities/MentionResolution",
  "title": "MentionResolution",
  "type": "object",
  "properties": {
    "written": {
      "type": "string",
      "description": "As written, such as @maya or @[p_123]"
    },
    "principal": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "human",
                "agent",
                "integration"
              ]
            },
            "display_name": {
              "type": "string"
            },
            "via": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "display_name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "display_name"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "kind",
            "display_name",
            "via"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "The member it mentions; null when it matched no one or several, and stays text"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "human",
              "agent",
              "integration"
            ]
          },
          "display_name": {
            "type": "string"
          },
          "via": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "display_name": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "display_name"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "display_name",
          "via"
        ],
        "additionalProperties": false
      },
      "description": "Who it could have meant when it matched several"
    }
  },
  "required": [
    "written",
    "principal",
    "candidates"
  ],
  "additionalProperties": false
}
