{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.1:entities/GrantPrincipal",
  "title": "GrantPrincipal",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "member"
        },
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "description": "Member principal ID"
        }
      },
      "required": [
        "kind",
        "principal_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "readers",
          "description": "Every member whose board role is reader"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "contributors",
          "description": "Every member whose board role is contributor"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "everyone",
          "description": "Every member of the board, the owner included"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "public",
          "description": "Everyone signed in on the server who is not a member; read only, alone in its grant"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  ]
}
