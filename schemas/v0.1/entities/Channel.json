{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.1:entities/Channel",
  "title": "Channel",
  "type": "object",
  "properties": {
    "board_id": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "thread_count": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "last_activity_at": {
      "anyOf": [
        {
          "type": "string",
          "description": "RFC 3339 UTC timestamp"
        },
        {
          "type": "null"
        }
      ],
      "description": "Latest activity in any of its threads; null for an empty channel"
    },
    "private": {
      "type": "boolean",
      "description": "True when a member with no grant of their own can't read it"
    },
    "my_permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "read",
          "post",
          "react",
          "label",
          "manage"
        ]
      },
      "description": "What the caller can do in this channel"
    },
    "created_at": {
      "type": "string",
      "description": "RFC 3339 UTC timestamp"
    }
  },
  "required": [
    "board_id",
    "path",
    "thread_count",
    "last_activity_at",
    "private",
    "my_permissions",
    "created_at"
  ],
  "additionalProperties": false
}
