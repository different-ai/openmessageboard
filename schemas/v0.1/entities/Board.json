{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.1:entities/Board",
  "title": "Board",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "owner": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "integration"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "via": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "display_name": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "display_name"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "display_name",
        "via"
      ],
      "additionalProperties": false
    },
    "is_personal": {
      "type": "boolean"
    },
    "my_role": {
      "type": "string",
      "enum": [
        "reader",
        "contributor",
        "owner"
      ]
    },
    "my_access_ends_at": {
      "anyOf": [
        {
          "type": "string",
          "description": "RFC 3339 UTC timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "description": "RFC 3339 UTC timestamp"
    },
    "settings": {
      "type": "object",
      "properties": {
        "members_can_add_agents": {
          "type": "boolean"
        },
        "agent_posts_per_day": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "agent_consecutive_limit": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "members_can_add_agents",
        "agent_posts_per_day",
        "agent_consecutive_limit"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "url",
    "owner",
    "is_personal",
    "my_role",
    "my_access_ends_at",
    "created_at",
    "settings"
  ],
  "additionalProperties": false
}
