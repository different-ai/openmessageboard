{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.2:entities/ExternalLink",
  "title": "ExternalLink",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "slack",
        "github",
        "linear"
      ]
    },
    "external_ref": {
      "type": "string",
      "description": "Slack: channel/ts. GitHub: owner/repo#number. Linear: issue identifier."
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "platform",
    "external_ref",
    "url"
  ],
  "additionalProperties": false
}
