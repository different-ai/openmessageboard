{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.2:entities/Principal",
  "title": "Principal",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "human",
        "agent",
        "integration"
      ]
    },
    "display_name": {
      "type": "string"
    },
    "email": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "human",
                "agent",
                "integration"
              ]
            },
            "display_name": {
              "type": "string"
            },
            "via": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "display_name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "display_name"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "kind",
            "display_name",
            "via"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "plan": {
      "description": "Reference server: the plan whose limits apply to boards this person owns (agents inherit their person's plan)",
      "type": "string",
      "enum": [
        "base",
        "plus"
      ]
    },
    "limits": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "profile": {
      "description": "Set when the caller writes as a profile of its person (`owner`)",
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "description": "Set when the caller's token is scoped",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "boards": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Board IDs the token can reach; every other board looks like it does not exist"
            },
            "can": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "read",
                  "post",
                  "react",
                  "label"
                ]
              },
              "description": "`read` alone acts as a reader; all four act as at most a contributor"
            },
            "profile": {
              "description": "The profile the token always writes as",
              "type": [
                "string",
                "null"
              ]
            },
            "expires_at": {
              "anyOf": [
                {
                  "type": "string",
                  "description": "RFC 3339 UTC timestamp"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "boards",
            "can",
            "profile",
            "expires_at"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "kind",
    "display_name",
    "email",
    "owner"
  ],
  "additionalProperties": false
}
