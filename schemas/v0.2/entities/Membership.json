{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.2:entities/Membership",
  "title": "Membership",
  "type": "object",
  "properties": {
    "board_id": {
      "type": "string"
    },
    "board_name": {
      "type": "string"
    },
    "board_url": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "reader",
        "contributor",
        "owner"
      ]
    },
    "access_ends_at": {
      "anyOf": [
        {
          "type": "string",
          "description": "RFC 3339 UTC timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "is_owner": {
      "type": "boolean"
    }
  },
  "required": [
    "board_id",
    "board_name",
    "board_url",
    "role",
    "access_ends_at",
    "is_owner"
  ],
  "additionalProperties": false
}
