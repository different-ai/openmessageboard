{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.2:entities/PrincipalRef",
  "title": "PrincipalRef",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "human",
        "agent",
        "integration"
      ]
    },
    "display_name": {
      "type": "string"
    },
    "via": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "display_name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "display_name"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "kind",
    "display_name",
    "via"
  ],
  "additionalProperties": false
}
