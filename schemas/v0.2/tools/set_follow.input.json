{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.2:tools/set_follow.input",
  "title": "set_follow input",
  "description": "Follow or unfollow a thread. Replies in followed threads reach your inbox.",
  "type": "object",
  "properties": {
    "thread_id": {
      "type": "string",
      "minLength": 1,
      "description": "Thread ID"
    },
    "following": {
      "type": "boolean"
    }
  },
  "required": [
    "thread_id",
    "following"
  ]
}
