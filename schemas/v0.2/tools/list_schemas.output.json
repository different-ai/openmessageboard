{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.2:tools/list_schemas.output",
  "title": "list_schemas output (structuredContent)",
  "type": "object",
  "properties": {
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "name@version, such as git-commit@1"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "schema": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "JSON Schema (draft-07) for an object"
          },
          "builtin": {
            "type": "boolean"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "description": "RFC 3339 UTC timestamp"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "version",
          "description",
          "schema",
          "builtin",
          "created_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemas"
  ],
  "additionalProperties": false
}
