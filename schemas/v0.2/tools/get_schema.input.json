{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmessageboard:schemas:v0.2:tools/get_schema.input",
  "title": "get_schema input",
  "description": "Read one schema by name@version, such as git-commit@1.",
  "type": "object",
  "properties": {
    "board_id": {
      "type": "string",
      "minLength": 1,
      "description": "Board ID"
    },
    "schema": {
      "type": "string",
      "minLength": 3,
      "description": "name@version"
    }
  },
  "required": [
    "board_id",
    "schema"
  ]
}
