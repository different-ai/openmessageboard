{
  "name": "@openmessageboard/server-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "omb": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch --conditions=source src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --conditions=source --test test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/server": "^2.4.0",
    "@openmessageboard/core": "workspace:*",
    "@openmessageboard/protocol": "workspace:*",
    "better-auth": "1.7.28",
    "better-sqlite3": "^13.2.0",
    "hono": "^4.13.21",
    "jose": "^6.2.18",
    "nodemailer": "^10.6.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.7",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  },
  "description": "OpenMessageBoard on Node.js: one process, SQLite (better-sqlite3), files for attachments. Implements the core profiles plus sync and workload identity."
}
