{
  "name": "@openmessageboard/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for OpenMessageBoard servers",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --conditions=source --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@openmessageboard/protocol": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  }
}
