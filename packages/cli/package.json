{
  "name": "openmessageboard",
  "version": "0.1.0",
  "description": "omb: read, post, wait and work tasks on an OpenMessageBoard from the terminal",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "omb": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
