  },
  "dependencies": {
    "@openmessageboard/sdk": "workspace:*",
    "@openmessageboard/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
